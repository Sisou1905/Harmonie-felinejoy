{
  "identity": {
    "name": "Harmonie Féline & Humaine",
    "tone": "Apaisant, Holistique, Joyeux, Scientifique",
    "archetype": "Organic & Earthy + Pastel Soft",
    "theme_mode": "light"
  },
  "typography": {
    "fonts": {
      "headings": "Fraunces, serif",
      "body": "Manrope, sans-serif",
      "ui": "Quicksand, sans-serif"
    },
    "scale": {
      "h1": "text-4xl md:text-6xl font-semibold tracking-tight leading-tight",
      "h2": "text-3xl md:text-4xl font-medium tracking-tight",
      "h3": "text-2xl md:text-3xl font-medium",
      "body_lg": "text-lg md:text-xl leading-relaxed text-stone-700",
      "body": "text-base leading-relaxed text-stone-600",
      "caption": "text-sm text-stone-500 font-medium"
    },
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;400;500;600&family=Manrope:wght@400;500;600&family=Quicksand:wght@400;500;600&display=swap"
  },
  "colors": {
    "palette": {
      "background": "#FAFAF9",
      "surface": "#FFFFFF",
      "primary": {
        "DEFAULT": "#5FA098",
        "light": "#D1E8E2",
        "dark": "#3A6E68",
        "foreground": "#FFFFFF"
      },
      "secondary": {
        "DEFAULT": "#A9D6E5",
        "light": "#E0F2F7",
        "dark": "#6B9EB0",
        "foreground": "#1A2F23"
      },
      "accent": {
        "DEFAULT": "#F4C7C3",
        "hover": "#EAB0AC",
        "foreground": "#5D2E2E"
      },
      "text": {
        "main": "#1A2F23",
        "muted": "#5C6B64",
        "light": "#8E9E96"
      },
      "border": "#E8E8E6"
    },
    "usage": {
      "body_bg": "bg-[#FAFAF9]",
      "card_bg": "bg-white",
      "text_main": "text-[#1A2F23]",
      "text_muted": "text-[#5C6B64]",
      "primary_btn": "bg-[#5FA098] hover:bg-[#3A6E68] text-white shadow-sm hover:shadow-md transition-all duration-300",
      "secondary_btn": "bg-[#D1E8E2] hover:bg-[#A9D6E5] text-[#1A2F23]",
      "accent_badge": "bg-[#F4C7C3] text-[#5D2E2E]"
    }
  },
  "visual_enhancers": {
    "radius": {
      "default": "rounded-2xl",
      "button": "rounded-full",
      "card": "rounded-3xl"
    },
    "shadows": {
      "soft": "shadow-[0_8px_30px_rgb(0,0,0,0.04)]",
      "float": "shadow-[0_20px_40px_rgb(95,160,152,0.1)]",
      "inner": "shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)]"
    },
    "gradients": {
      "subtle_mesh": "bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-green-50 via-stone-50 to-blue-50",
      "glow": "bg-gradient-to-tr from-[#D1E8E2] to-[#A9D6E5]"
    },
    "glassmorphism": {
      "header": "bg-white/70 backdrop-blur-xl border-b border-white/20",
      "card": "bg-white/60 backdrop-blur-lg border border-white/40 shadow-sm"
    }
  },
  "layout": {
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
    "section_spacing": "py-24 md:py-32",
    "grid_bento": "grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8",
    "article": "max-w-2xl mx-auto"
  },
  "components": {
    "buttons": {
      "style": "h-11 px-8 rounded-full font-medium transition-transform active:scale-95",
      "primary": "bg-[#5FA098] text-white hover:bg-[#4D857E]",
      "ghost": "hover:bg-[#D1E8E2]/30 text-[#1A2F23]"
    },
    "mind_map": {
      "container": "h-[600px] w-full bg-[#F5F7F6] rounded-[2.5rem] border-4 border-white shadow-inner overflow-hidden",
      "node": {
        "base": "px-6 py-4 rounded-2xl shadow-sm border-2 border-white min-w-[150px] text-center font-medium",
        "root": "bg-[#5FA098] text-white text-lg",
        "branch": "bg-[#A9D6E5] text-[#1A2F23]",
        "leaf": "bg-white text-[#5C6B64] border-[#D1E8E2]"
      },
      "edge": {
        "stroke": "#B0C4DE",
        "strokeWidth": 2,
        "animated": true
      }
    },
    "product_card": {
      "wrapper": "group relative bg-white rounded-3xl p-4 transition-all hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] border border-transparent hover:border-[#D1E8E2]",
      "image": "aspect-square rounded-2xl bg-stone-50 object-cover mix-blend-multiply",
      "badge": "absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-[#5FA098]"
    }
  },
