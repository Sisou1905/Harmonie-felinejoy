  "instructions_to_main_agent": [
    "1. THEME SETUP: Implement the 'Fraunces' and 'Manrope' fonts immediately. This is critical for the 'Soft Wellness' identity.",
    "2. REACT FLOW: When building mind maps, use custom node components. Do not use default rectangular nodes. Use the styles defined in 'components.mind_map'.",
    "3. SHOP INTEGRATION: Create a 'ProductSpotlight' component that can be embedded in articles. Use a subtle, non-intrusive design. Link to 'www.felinejoycamy.myshopify.com' and 'https://www.zinzino.com/2020929659'.",
    "4. ANIMATION: Use 'framer-motion' for page transitions. Pages should 'fade in and float up' gently (y: 20 -> y: 0).",
    "5. ACQUISITION: The Newsletter component should be 'Sticky' but gentle. Maybe a bottom-right floating pill or a soft banner at the end of articles.",
    "6. AUTH: Ensure the Google Login button is styled to match the theme (White pill with shadow, not standard blue/black).",
    "7. COMMENTS: Use a clean, threaded design for comments. Avatars should be circles with pastel placeholders if no image.",
    "8. SEO: Ensure every page has a dynamic title using React Helmet or similar.",
    "9. UNIVERSAL: Avoid pure black. Use #1A2F23 for all main text."
  ],
  "universal_guidelines": [
    "Don't make generic centered layouts.",
    "Create depth through layered design elements with z-index hierarchy.",
    "Use glass-morphism effects with backdrop filters.",
    "Every interaction needs micro-animations.",
    "Use 2-3x more spacing than feels comfortable.",
    "Subtle grain textures, noise overlays, custom cursors.",
    "Never use pure black or default gray."
  ]
}