    },
    {
      "source": "/connexion",
      "destination": "/connexion/index.html"
    },
    {
      "source": "/a-propos",
      "destination": "/a-propos/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
